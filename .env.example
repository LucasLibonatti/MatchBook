# Variáveis de ambiente do servidor (NUNCA use prefixo VITE_ para chaves secretas)
# Obtenha sua chave Groq em: https://console.groq.com/keys
GROQ_API_KEY=gsk_sua_chave_groq_aqui

# Opcional: melhora limites de busca de livros/capas no Google Books
GOOGLE_BOOKS_API_KEY=sua_chave_google_books_aqui

# Porta local do servidor Hono em desenvolvimento (padrão: 3001)
API_PORT=3001
